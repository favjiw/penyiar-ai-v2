assets/avatar/*/manifest.json

# OS / IDE
.idea/
.vscode/*
.DS_Store
Thumbs.db
desktop.ini

# Data runtime (blocker tersimpan, dll.)
backend/data/

# Sesi (blocker.json per sesi; log JSONL menyusul di Fase 4)
backend/sessions/

# Hosting: rahasia lokal untuk deploy (sandi login sementara, dll.)
deploy/*.local*
deploy/secrets*
