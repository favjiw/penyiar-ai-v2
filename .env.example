# Salin ke .env lalu isi. Jangan commit .env. (Branch full free service: 100% gratis)

# Mode
LLM_MODE=mock                 # live | mock
TTS_MODE=mock                 # live | mock

# Gemini Free Tier (kunci API dari Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL_BLOCKER=gemini-3.5-flash-lite
GEMINI_MODEL_PERSONA=gemini-3.5-flash-lite
GEMINI_MODEL_PERSONA_FALLBACK=   # opsional: model Gemini gratis lain saat kuota RPD model utama habis
GEMINI_MODEL_SHOWRUNNER=gemini-3.5-flash-lite
GEMINI_MODEL_SUPERVISOR=gemini-3.5-flash-lite
GEMINI_MODEL_TTS=
GEMINI_MODEL_JUDGE=
GEMINI_RPM_DEFAULT=15           # free tier Flash-Lite: 15 RPM
GEMINI_RPD_DEFAULT=500          # free tier terukur 500/hari/model
GEMINI_RPD_BLOCKER=
GEMINI_RPD_PERSONA=
GEMINI_RPD_SUPERVISOR=
GEMINI_RPD_SHOWRUNNER=
AI_TURNS_PER_MIN_A=4
AI_TURNS_PER_MIN_B=7
GEMINI_RPM_BLOCKER=
GEMINI_RPM_PERSONA=
GEMINI_RPM_SUPERVISOR=
GEMINI_RPM_SHOWRUNNER=
GEMINI_RPM_TTS=

# TTS Gratis: Edge TTS (utama, tanpa API key) + gTTS (cadangan, tanpa API key)
TTS_PROVIDER=edge             # edge | gtts
TTS_FALLBACK=gtts             # cadangan berurutan, dipisah koma: gtts | edge | none
TTS_RETRIES=1
TTS_TIMEOUT_SEC=12
EDGE_VOICE_MALE=id-ID-ArdiNeural
EDGE_VOICE_FEMALE=id-ID-GadisNeural
EDGE_VOICE_RAKA=
EDGE_VOICE_SALSA=
EDGE_RATE_RAKA=+4%
EDGE_PITCH_RAKA=-2Hz
EDGE_RATE_SALSA=+6%
EDGE_PITCH_SALSA=+2Hz

# STT Gratis (mode A)
STT_PROVIDER=webspeech        # webspeech (Chrome gratis) | faster_whisper (lokal)
FASTER_WHISPER_URL=

# Agen
SHOWRUNNER_POLICY=llm         # llm | fixed_turns | coverage_only
SHOWRUNNER_EVERY_K=3
MIN_TURNS_PER_TOPIC=6
MAX_TURNS_PER_TOPIC=60
FIXED_TURNS_PER_TOPIC=
SUPERVISOR_MODE=off           # off (pass-through, default) | rules | full
SUPERVISOR_MAX_REGEN=1
SUPERVISOR_TIMEOUT_MS=5000
PERSONA_TIMEOUT_MS=20000
PERSONA_FAILURES_BEFORE_WRAP=3
PERSONA_FAILURE_WRAP_SEC=90
SHOWRUNNER_TIMEOUT_MS=6000
PIPELINE_DEPTH=2
OPENING_TURNS=2
CLOSING_TURNS=2
POINT_TIME_LIMIT_S=60
POINT_LIMIT_FROM_TOPIC=true
MODE_A_NUDGE_AFTER_S=120
VOICE_TOPIC_SWITCH=true
VOICE_SWITCH_UNDO_S=10
POINT_WRAP_S=15
POINT_MIN_TURNS=3
TTS_WORDS_PER_SEC=2.3          # Edge TTS terukur ~2.3 kata/dtk
SESSION_TARGET_MIN=0
PERSONA_TEMPERATURE=0.9
SUMMARY_EVERY_TURNS=10

# Penyeimbang volume per penyiar (dB, -12..9), diterapkan di layar OBS (/stage). 0 = tanpa perubahan.
VOICE_GAIN_DB_RAKA=
VOICE_GAIN_DB_SALSA=

# Database dan login. Semua data aplikasi ada di database (kosong = SQLite lokal di DATA_DIR).
DATABASE_URL=
AUTH_REQUIRED=false
AUTH_SESSION_HOURS=168
AUTH_COOKIE_SECURE=false
AUTH_MAX_FAILURES=5
AUTH_LOCKOUT_MIN=15

# Kunci induk enkripsi kunci API yang disimpan lewat halaman admin (/admin). Buat: python -m app.cli gen-secrets-key
SECRETS_KEY=
