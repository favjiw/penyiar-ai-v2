# Salin ke .env lalu isi. Jangan commit .env. (PRD Lampiran B)

# Mode
LLM_MODE=mock                 # live | mock
TTS_MODE=mock                 # live | mock

# Gemini (model ID diisi setelah dicek di AI Studio, Tahap 0)
GEMINI_API_KEY=
GEMINI_MODEL_BLOCKER=gemini-3.5-flash-lite   # KT FR-1: 10/10 tema 5,8-8,1 s; gemini-flash-latest 149 s
GEMINI_MODEL_PERSONA=gemini-3.5-flash-lite        # ±1,5 s per giliran (gerbang Tahap 2)
GEMINI_MODEL_PERSONA_FALLBACK=compat:gemini-3.8-flash  # [F] cadangan persona saat kuota harian Gemini habis (500 RPD/model); berbayar kecil
GEMINI_MODEL_SHOWRUNNER=gemini-flash-lite-latest  # ±1 s; 3.1-flash-lite sering 503/timeout di gerbang Tahap 2
GEMINI_MODEL_SUPERVISOR=gemini-3.5-flash-lite     # p50 1,2 s; 3.1-flash-lite sering 503
GEMINI_MODEL_TTS=
GEMINI_MODEL_JUDGE=
GEMINI_RPM_DEFAULT=5            # dipakai bila GEMINI_RPM_<PERAN> kosong
GEMINI_RPM_BLOCKER=
GEMINI_RPM_PERSONA=
GEMINI_RPM_SUPERVISOR=
GEMINI_RPM_SHOWRUNNER=
GEMINI_RPM_TTS=

# Endpoint kompatibel OpenAI untuk LLM cadangan [F] (berbayar ±$0,00001 per panggilan): aktif lewat
# model "compat:<nama>" di GEMINI_MODEL_*. Dipakai untuk cadangan persona dan eksperimen offline FR-14.
OPENAI_COMPAT_BASE_URL=https://api.cosmoshub.tech/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_REASONING_EFFORT=none   # dengan reasoning satu giliran 8-18 s; tanpa ±3 s

# TTS
# Pengembangan dan uji panjang: edge (gratis, tanpa key). Demo ke pembimbing: elevenlabs (ganti satu baris ini).
TTS_PROVIDER=edge             # edge | elevenlabs
TTS_FALLBACK=gtts             # cadangan berurutan, dipisah koma: edge | gtts | elevenlabs | none (demo: edge,gtts)
TTS_RETRIES=1                 # ulang provider utama sekali sebelum pindah ke cadangan
TTS_TIMEOUT_SEC=12
# Edge: Raka = Ardi, Salsa = Gadis. Rate/pitch per persona (format Edge: +5%, -3Hz); stel dengan didengar.
EDGE_VOICE_MALE=id-ID-ArdiNeural
EDGE_VOICE_FEMALE=id-ID-GadisNeural
EDGE_RATE_RAKA=+4%
EDGE_PITCH_RAKA=-2Hz
EDGE_RATE_SALSA=+6%
EDGE_PITCH_SALSA=+2Hz
# ElevenLabs (PRD v2.2 FR-6). Pratama = Raka, Aita = Salsa. Tanpa key, TTS_PROVIDER=elevenlabs jatuh ke Edge dengan peringatan.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_MALE=q8qwd1jY2jS3AWOBeq25
ELEVENLABS_VOICE_FEMALE=ffTJE9l3Kt2ipEM32UOc

# STT (mode A)
STT_PROVIDER=webspeech        # webspeech | faster_whisper | gemini
FASTER_WHISPER_URL=

# Agen
SHOWRUNNER_POLICY=llm         # llm | fixed_turns | coverage_only
SHOWRUNNER_EVERY_K=3
MIN_TURNS_PER_TOPIC=6
MAX_TURNS_PER_TOPIC=40
FIXED_TURNS_PER_TOPIC=
SUPERVISOR_MODE=full          # off | rules | full
SUPERVISOR_MAX_REGEN=1
SUPERVISOR_TIMEOUT_MS=5000
PERSONA_TIMEOUT_MS=10000        # lewat batas → kalimat aman (hindari siaran hening)
PERSONA_FAILURES_BEFORE_WRAP=3  # persona gagal beruntun sebanyak ini...
PERSONA_FAILURE_WRAP_SEC=90     # ...dan selama ini → siaran dibawa ke Closing (kuota habis tanpa cadangan: langsung)
SHOWRUNNER_TIMEOUT_MS=6000      # lewat batas → keputusan fixed_turns
PIPELINE_DEPTH=1
OPENING_TURNS=2
CLOSING_TURNS=2
SESSION_TARGET_MIN=0           # petunjuk lunak durasi untuk Showrunner; 0 = tanpa
PERSONA_TEMPERATURE=0.9

