# Salin ke .env lalu isi. Jangan commit .env. (PRD Lampiran B)

# Mode
LLM_MODE=mock                 # live | mock
TTS_MODE=mock                 # live | mock

# Gemini (model ID diisi setelah dicek di AI Studio, Tahap 0)
GEMINI_API_KEY=
GEMINI_MODEL_BLOCKER=
GEMINI_MODEL_PERSONA=
GEMINI_MODEL_SHOWRUNNER=
GEMINI_MODEL_SUPERVISOR=
GEMINI_MODEL_TTS=
GEMINI_MODEL_JUDGE=
GEMINI_RPM_PERSONA=
GEMINI_RPM_SUPERVISOR=
GEMINI_RPM_SHOWRUNNER=
GEMINI_RPM_TTS=

# TTS
TTS_PRIMARY=gemini
TTS_FALLBACK=edge
GEMINI_VOICE_MALE=
GEMINI_VOICE_FEMALE=
EDGE_VOICE_MALE=id-ID-ArdiNeural
EDGE_VOICE_FEMALE=id-ID-GadisNeural

# STT (mode A)
STT_PROVIDER=webspeech        # webspeech | faster_whisper | gemini
FASTER_WHISPER_URL=

# Agen
SHOWRUNNER_POLICY=llm         # llm | fixed_turns | coverage_only
SHOWRUNNER_EVERY_K=3
MIN_TURNS_PER_TOPIC=6
MAX_TURNS_PER_TOPIC=40
FIXED_TURNS_PER_TOPIC=
SUPERVISOR_MODE=full          # off | rules | full
SUPERVISOR_MAX_REGEN=1
SUPERVISOR_TIMEOUT_MS=5000
PIPELINE_DEPTH=1

# Avatar
AVATAR_TIER=t1                # t1 | t2
AVATAR_WORKER_URL=

# Skripsi
COMMENTS_ENABLED=false
TIKTOK_USERNAME=
