# Salin ke /opt/penyiar/.env di VPS (chmod 600). Berkas .env asli TIDAK boleh masuk git.
# Variabel lain mengikuti .env.example di root repo (model, TTS, Simli, dll.).

# ── Hosting ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=ganti-dengan-sandi-acak-panjang
IMAGE_TAG=latest              # atau sha-<7 huruf> untuk versi tertentu (rollback = ganti ini)
# DATABASE_URL, AUTH_REQUIRED, dan AUTH_COOKIE_SECURE diatur di docker-compose.yml (bukan di sini),
# supaya login tidak bisa tanpa sengaja mati lewat .env. Akun pertama dibuat lewat CLI (deploy/README.md).

# ── Mode ─────────────────────────────────────────────────────────────────────
LLM_MODE=live
TTS_MODE=live
SUPERVISOR_MODE=off           # KP: tanpa Supervisor
PILOT_CONDITION=A

# ── Kunci layanan (hanya di server) ─────────────────────────────────────────
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
SIMLI_API_KEY=
OPENAI_COMPAT_API_KEY=
